NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/social
REDIS_URL=redis://:PASSWORD@REDIS_HOST:6379
API_PORT=3001
WS_PORT=3002
NEXT_PUBLIC_API_URL=https://api.example.com
WEB_URL=https://example.com
MEDIA_CDN_URL=https://cdn.example.com
